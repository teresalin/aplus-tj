generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
  Other

  @@map("gender")
}

// A moved session stays Scheduled at its new time; the move itself is
// recorded in SessionTimeChange.
enum SessionStatus {
  Scheduled
  Cancelled

  @@map("session_status")
}

enum day_of_week {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

model Person {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  preferredName String?  @map("preferred_name")
  gender        Gender?
  phone         String?
  // Optional because young students often have no email of their own; the app
  // still requires one for parents and staff. Unique among non-null values.
  email         String?  @unique
  dateOfBirth   DateTime @map("date_of_birth")
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  staff           Staff?
  parent          Parent?
  student         Student?
  userIdentifiers UserIdentifier[]

  @@unique([name, dateOfBirth], name: "unique_person_details")
  @@map("person")
}

model StaffRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  staff Staff[]

  @@map("staff_role")
}

model Staff {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId   String?   @unique @map("staff_id")
  roleId    String    @map("role_id") @db.Uuid // ← FK to StaffRole.id
  hireDate  DateTime  @map("hire_date")
  leaveDate DateTime? @map("leave_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  role   StaffRole @relation(fields: [roleId], references: [id])
  person Person    @relation(fields: [id], references: [id])

  classes  Class[]
  sessions Session[]

  @@map("staff")
}

model Parent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?  @unique @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  person Person @relation(fields: [id], references: [id])

  @@map("parent")
}

model Grade {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  students Student[]
  classes  Class[]

  @@map("grade")
}

model Student {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String?   @unique @map("student_id")
  gradeId           String    @map("grade_id") @db.Uuid // ← FK to Grade.id
  admissionDate     DateTime  @map("admission_date")
  departureDate     DateTime? @map("departure_date")
  currentSchool     String?   @map("current_school")
  textbookPublisher String?   @map("textbook_publisher")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  person Person @relation(fields: [id], references: [id])
  grade  Grade  @relation(fields: [gradeId], references: [id])

  attendances    Attendance[]
  classStudents  ClassStudent[]
  billingRecords StudentBillingRecord[]
  paymentMethods StudentPaymentMethod[]

  @@map("student")
}

model UserIdentifier {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId      String   @map("person_id") @db.Uuid // ← FK to Person.id
  name          String
  value         String
  isSocialMedia Boolean? @map("is_social_media")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id])

  @@map("user_identifier")
}

model Class {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  teacherId String   @map("teacher_id") @db.Uuid // ← FK to Staff.id
  gradeId   String   @map("grade_id") @db.Uuid // ← FK to Grade.id
  capacity  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  teacher          Staff             @relation(fields: [teacherId], references: [id])
  grade            Grade             @relation(fields: [gradeId], references: [id])
  classStudents    ClassStudent[]
  classCosts       ClassCost[]
  sessions         Session[]
  schedules        Schedule[]
  classAssignments ClassAssignment[]

  @@map("class")
}

model ClassCost {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId       String    @map("class_id") @db.Uuid // ← FK to Class.id
  cost          Decimal
  currency      String?
  effectiveDate DateTime? @map("effective_date")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  class Class @relation(fields: [classId], references: [id])

  @@map("class_cost")
}

model ClassStudent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String    @map("class_id") @db.Uuid // ← FK to Class.id
  studentId String    @map("student_id") @db.Uuid // ← FK to Student.id
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("class_student")
}

model Session {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId            String        @map("class_id") @db.Uuid // ← FK to Class.id; never changes, since attendance belongs to the class
  // Who taught this session: the class's teacher when it was created, or a substitute.
  teacherId          String        @map("teacher_id") @db.Uuid // ← FK to Staff.id
  startTime          DateTime      @map("start_time")
  endTime            DateTime      @map("end_time")
  status             SessionStatus @default(Scheduled)
  cancellationReason String?       @map("cancellation_reason")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")

  class       Class               @relation(fields: [classId], references: [id])
  teacher     Staff               @relation(fields: [teacherId], references: [id])
  attendances Attendance[]
  timeChanges SessionTimeChange[]

  @@unique([classId, startTime, endTime], name: "unique_session_details")
  @@map("session")
}

// One change to a session's start or end time; rows are only ever added,
// in the same transaction as the change.
model SessionTimeChange {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid // ← FK to Session.id
  previousStartTime DateTime @map("previous_start_time")
  previousEndTime   DateTime @map("previous_end_time")
  newStartTime      DateTime @map("new_start_time")
  newEndTime        DateTime @map("new_end_time")
  reason            String?
  changedBy         String?  @map("changed_by") // email of the staff member who made the change
  changedAt         DateTime @default(now()) @map("changed_at")

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("session_time_change")
}

model Attendance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid // ← FK to Session.id
  studentId String   @map("student_id") @db.Uuid // ← FK to Student.id
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  session Session @relation(fields: [sessionId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("attendance")
}

model Assignment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  description      String?
  dueDate          DateTime?         @map("due_date")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  classAssignments ClassAssignment[]

  @@map("assignment")
}

model ClassAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId      String   @map("class_id") @db.Uuid // ← FK to Class.id
  assignmentId String   @map("assignment_id") @db.Uuid // ← FK to Assignment.id
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  class      Class      @relation(fields: [classId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@map("class_assignment")
}

model Schedule {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String      @map("class_id") @db.Uuid // ← FK to Class.id
  dayOfWeek day_of_week @map("day_of_week")
  startTime DateTime    @map("start_time") @db.Time
  endTime   DateTime    @map("end_time") @db.Time
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  class Class @relation(fields: [classId], references: [id])

  @@map("schedule")
}

model Holiday {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("holiday")
}

model StudentBillingRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String    @map("student_id") @db.Uuid // ← FK to Student.id
  billingDate   DateTime? @map("billing_date")
  description   String?
  amount        Int?
  paymentMethod String?   @map("payment_method")
  invoiceNumber String?   @map("invoice_number")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  student        Student                @relation(fields: [studentId], references: [id])
  billingDetails StudentBillingDetail[]

  @@map("student_billing_record")
}

model StudentBillingDetail {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingRecordId String   @map("billing_record_id") @db.Uuid // ← FK to StudentBillingRecord.id
  categoryId      String?  @map("category_id") @db.Uuid // ← FK to BillingCategory.id
  amount          Decimal?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  billingRecord StudentBillingRecord @relation(fields: [billingRecordId], references: [id])
  category      BillingCategory?     @relation(fields: [categoryId], references: [id])

  @@map("student_billing_detail")
}

model StudentPaymentMethod {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String    @map("student_id") @db.Uuid // ← FK to Student.id
  paymentMethod  String?   @map("payment_method")
  accountNumber  String?   @map("account_number")
  expirationDate DateTime? @map("expiration_date")
  billingAddress String?   @map("billing_address")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_payment_method")
}

model BillingCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  billingDetails StudentBillingDetail[]

  @@map("billing_category")
}
