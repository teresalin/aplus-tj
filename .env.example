# Copy to .env.local and fill in. Next.js loads .env* files automatically;
# the Prisma CLI reads DATABASE_URL from prisma/.env (or the environment).

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/aplus?schema=public"

# NextAuth. NEXTAUTH_SECRET is required in every environment (the middleware
# uses it to read session tokens). Generate one with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Role assignment: comma-separated emails, or "@domain" to match a whole domain.
# Admins can view and edit everything; teachers can view. Anyone else who signs
# in is sent to /no-access.
AUTH_ADMIN_EMAILS="owner@example.com"
AUTH_TEACHER_EMAILS="@example.com"
