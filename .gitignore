# ───── Node / package manager ─────
/node_modules/
/.pnp
.pnp.js
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ───── Build outputs ─────
/.next/
/out/
/build/

# ───── Local env vars ─────
.env*
!.env.example

# ───── Databases & dumps ─────
/.db_data/
/prisma/dev.db        # if you ever use SQLite
.dockerignore         # sometimes auto-generated

# ───── Generated code ─────
/generated/prisma_client/
/.prisma/              # Prisma’s hidden client folder
tsconfig.tsbuildinfo    

# ───── Caches & coverage ─────
/.cache/
/coverage/

# ───── IDE / Editor ─────
.vscode/
/.idea/
/*.suo
/*.ntvs*
/*.njsproj
/*.sln

# ───── OS files ─────
.DS_Store
Thumbs.db

# ───── Logs ─────
*.log
*.log.*

# ───── Vercel & deployment ─────
.vercel/
/.vercel_build_output/

# ───── Misc ─────
*.swp
